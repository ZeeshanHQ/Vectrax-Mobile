# ============================================
# Supabase Pulse — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
#
# Get CLIENT_ID and CLIENT_SECRET from:
# https://supabase.com/dashboard/org/_/apps
# ============================================

SUPABASE_OAUTH_CLIENT_ID=your-oauth-client-id
SUPABASE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
SUPABASE_OAUTH_REDIRECT_URI=com.supabasepulse://login-callback
